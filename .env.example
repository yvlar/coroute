# ─────────────────────────────────────────────────────────────────────
# CoRoute — exemple de configuration d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
# NE JAMAIS committer le fichier `.env` réel.
# ─────────────────────────────────────────────────────────────────────

# ─── MongoDB ─────────────────────────────────────────────────────────
# Identifiants de la base (utilisés par docker-compose pour initialiser Mongo).
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB=coroute
# URI complète utilisée par le backend. En Docker :
#   mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@mongo:27017/?authSource=admin
MONGO_URI=

# ─── JWT (backend) ───────────────────────────────────────────────────
# Secret de signature HMAC : AU MOINS 32 caractères. Générer une valeur
# aléatoire forte pour la production (ex. `openssl rand -base64 48`).
# Laisser vide ici : le backend refuse de démarrer sans secret valide.
JWT_SECRET=
# Durée de validité du token en secondes (défaut 86400 = 24 h).
JWT_EXPIRATION_SECONDS=86400

# ─── CORS (backend) ──────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules. Aucune origine n'est
# autorisée par défaut.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ─── OWASP Dependency-Check (backend, CI) ────────────────────────────
# Clé API NVD pour accélérer le téléchargement de la base de vulnérabilités.
# Obtenir une clé sur https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ─── Frontend ────────────────────────────────────────────────────────
# URL de base de l'API. En dev (proxy Vite) et en prod (nginx) : /api
VITE_API_URL=/api

# ─── Mongo Express (profil dev-tools uniquement) ─────────────────────
# Identifiants de la console web d'administration Mongo (jamais admin/password).
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
